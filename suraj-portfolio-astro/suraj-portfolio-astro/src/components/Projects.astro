---
import type { Project } from "../data/content";
interface Props { projects: Project[] }
const { projects } = Astro.props;
---
<section id="work">
  <div class="label"><h2 class="serif">Selected work</h2><span>Scroll →</span></div>
  <div class="hwrap" id="hwrap">
    <div class="htrack" id="htrack">
      {projects.map((p, i) => (
        <a class="proj" href={p.link} target="_blank" rel="noopener">
          <span class="go">↗</span>
          <div class="n serif">{String(i + 1).padStart(2, "0")}</div>
          <div>
            <h3 class="serif">{p.title}</h3>
            <p>{p.description}</p>
            <div class="tags">{p.tags.map((t) => <i>{t}</i>)}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
