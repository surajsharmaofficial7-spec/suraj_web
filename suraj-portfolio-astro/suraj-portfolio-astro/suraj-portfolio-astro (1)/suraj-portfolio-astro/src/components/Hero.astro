---
import type { Home } from "../data/content";
const { home } = Astro.props as { home: Home };
---
<header class="hero" id="top">
  <div class="eyebrow">{home.eyebrow}</div>
  <h1 class="serif">{home.heroPrefix} <em>{home.heroAccent}</em><br />{home.heroSuffix}</h1>
  <p>{home.heroText}</p>
  <div class="meta"><span>{home.meta1}</span><span>{home.meta2}</span><span>{home.meta3}</span></div>
</header>
