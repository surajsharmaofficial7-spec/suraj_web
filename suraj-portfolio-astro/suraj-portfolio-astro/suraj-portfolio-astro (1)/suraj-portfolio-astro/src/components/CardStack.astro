---
import type { StackCard } from "../data/content";
const { cards } = Astro.props as { cards: StackCard[] };
---
<section id="about">
  <div class="label"><h2 class="serif">Experience &amp; craft</h2><span>Stack ↓</span></div>
  <div class="stack">
    {cards.map((c, i) => (
      <article class="card" style={`--i:${i}`}>
        <div>
          <div class="k">{c.kind}</div>
          <h3 class="serif">{c.title}</h3>
          {c.sub && <p style="color:var(--mute);margin-top:8px">{c.sub}</p>}
        </div>
        {c.layout === "chips" ? (
          <div class="chips">{c.items.map((x) => <span>{x.t}</span>)}</div>
        ) : (
          <ul>{c.items.map((x) => <li>{x.b && <b>{x.b} — </b>}{x.t}</li>)}</ul>
        )}
      </article>
    ))}
  </div>
</section>
